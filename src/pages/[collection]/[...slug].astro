---
/**
 * GENERIC detail page for AUTO-DISCOVERED collections.
 *
 * Any new folder under src/content/<name>/ (that has no dedicated route)
 * automatically gets URLs here: /<name>/<file>/
 * Curated routes (/digimon/, /accessories/) take precedence over this one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import EntryIcon from '../../components/EntryIcon.astro';
import TamerList from '../../components/TamerList.astro';
import { getCollection, render } from 'astro:content';
import { getAutoCollectionNames } from '../../lib/navigation';
import { resolveIcon } from '../../lib/icons';

/** Special pages that get extra components injected after the markdown body. */
const SPECIAL_INJECTIONS: Record<string, any> = {
  'system:tamer': TamerList,
};

export async function getStaticPaths() {
  const names = getAutoCollectionNames();
  const perCollection = await Promise.all(
    names.map(async (collection) => {
      const entries = await getCollection(
        collection as Parameters<typeof getCollection>[0]
      );
      return entries.map((entry) => ({
        params: { collection, slug: entry.id },
        props: { entry },
      }));
    })
  );
  return perCollection.flat();
}

interface Props {
  /* eslint-disable-next-line @typescript-eslint/no-explicit-any */
  entry: any;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Prev / next within the same auto-collection (sorted by "order")
const siblings = (
  await getCollection(entry.collection as Parameters<typeof getCollection>[0])
).sort(
  (a, b) =>
    ((a.data as Record<string, unknown>).order as number ?? 99) -
    ((b.data as Record<string, unknown>).order as number ?? 99)
);
const index = siblings.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;

const data = entry.data as Record<string, any>;
const base = `/${entry.collection}/`;
---

<BaseLayout title={`${data.title} — DIGIWIKI`} description={data.description}>
  <div class="page-grid">
    <Sidebar collection={entry.collection} />
    <article>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/hub/">← All Entries</a> <span>/</span>
        <a href={base}>{entry.collection}</a> <span>/</span>
        <span class="here">{data.title}</span>
      </nav>

      <header class="head panel">
        <span class="emoji">
          <EntryIcon name={resolveIcon({ collection: entry.collection, slug: entry.id, icon: data.icon })} emoji={data.emoji} />
        </span>
        <div>
          <h1>{data.title}</h1>
          <div class="meta">
            {data.category && <span class="badge blue">{data.category}</span>}
            {data.owner && <span class="badge accent">Owner: {data.owner}</span>}
          </div>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {SPECIAL_INJECTIONS[`${entry.collection}:${entry.id}`] && (
        <SPECIAL_INJECTIONS[`${entry.collection}:${entry.id}`] />
      )}

      {
        data.tags?.length > 0 && (
          <p class="tags">
            {data.tags.map((tag: string) => (
              <span class="badge">#{tag}</span>
            ))}
          </p>
        )
      }

      <hr />

      <nav class="pager" aria-label="Entry navigation">
        {
          prev ? (
            <a class="btn" href={`${base}${prev.id}/`}>
              ← {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="btn" href={`${base}${next.id}/`}>
              {next.data.title} →
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .here { color: var(--accent); }
  .head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .head :global(.emoji) { font-size: 4rem; line-height: 1; }
  .head h1 { margin: 0 0 0.4rem; }
  .meta { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
