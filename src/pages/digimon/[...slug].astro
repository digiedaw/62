---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import EntryIcon from '../../components/EntryIcon.astro';
import { getCollection, render } from 'astro:content';
import { resolveIcon } from '../../lib/icons';

export async function getStaticPaths() {
  const entries = await getCollection('digimon');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'digimon'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Prev / next navigation across the whole collection (sorted by "order")
const all = (await getCollection('digimon')).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const data = entry.data;

// Name-based icon: bare name or slug auto-match inside public/digimon/
const icon = resolveIcon({ collection: 'digimon', slug: entry.id, icon: data.icon });
---

<BaseLayout title={`${data.title} — DIGIWIKI`} description={data.description}>
  <div class="page-grid">
    <Sidebar collection="digimon" />
    <article>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/hub/">← All Entries</a> <span>/</span> <a href="/digimon/">Digimon</a> <span>/</span> <span class="here">{data.title}</span>
      </nav>

      <header class="head panel">
        <EntryIcon name={icon} emoji={data.emoji} class="emoji" />
        <div>
          <h1>{data.title}</h1>
          <div class="meta">
            {data.rank && <span class="badge accent">Rank {data.rank}</span>}
            {data.stage && <span class="badge blue">{data.stage}</span>}
            {data.attribute && <span class="badge">{data.attribute}</span>}
            {data.role && <span class="badge">{data.role}</span>}
            {data.partner && <span class="badge">Partner: {data.partner}</span>}
          </div>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        data.tags.length > 0 && (
          <p class="tags">
            {data.tags.map((tag) => (
              <span class="badge">#{tag}</span>
            ))}
          </p>
        )
      }

      <hr />

      <nav class="pager" aria-label="Entry navigation">
        {
          prev ? (
            <a class="btn" href={`/digimon/${prev.id}/`}>
              ← {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="btn" href={`/digimon/${next.id}/`}>
              {next.data.title} →
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .here { color: var(--accent); }

  .head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .head :global(.emoji) { font-size: 4rem; line-height: 1; }
  .head h1 { margin: 0 0 0.4rem; }
  .meta { display: flex; gap: 0.4rem; flex-wrap: wrap; }

  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 1.5rem; }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
