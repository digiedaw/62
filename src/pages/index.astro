---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllCollectionNames } from '../lib/navigation';
import { resolveIcon } from '../lib/icons';
import data from '../data/homepage.json';
import EntryIcon from '../components/EntryIcon.astro';

const patchHref = '/patchnote/';

const entries = (await getCollection('digimon')).sort(
  (a, b) => a.data.order - b.data.order
);

// Live count across EVERY collection (curated + auto-discovered folders)
const collectionTotals = await Promise.all(
  getAllCollectionNames().map(async (name) => {
    const items = await getCollection(
      name as Parameters<typeof getCollection>[0]
    );
    return items.length;
  })
);
const totalEntries = collectionTotals.reduce((sum, n) => sum + n, 0);

const stats = [
  { value: String(totalEntries), label: 'wiki entries' },
  { value: '100%', label: 'static Markdown' },
];

const publicPath = (p: string): string =>
  p.startsWith('/') ? p : `/${p}`;
// ── Raid schedule timing ────────────────────────────────────────────────
// Each area starts at its own minute mark (startMinute in homepage.json):
//   Forest of Beginning xx:00 · Forest of Marionette xx:06
//   Metal Empire xx:12       · Top of Nightmare xx:18
// Channels within an area run back-to-back every `channelMinutes`.
// A tiny client script (bottom of this file) recomputes statuses live.
const raidAreas = data.raid?.areas ?? [];
const slotSeconds = (data.raid?.channelMinutes ?? 2) * 60;
const areasWithSlots = raidAreas.map((area) => {
  const areaStart = (area.startMinute ?? 0) * 60;
  return {
    ...area,
    channels: area.channels.map((ch, i) => ({
      ...ch,
      offset: areaStart + i * slotSeconds,
    })),
  };
});


---

<BaseLayout>
  <section class="hero">
    <span class="badge accent">fan-made knowledge base</span>
    <h1>Explore the <span class="glow">Digital World</span>.</h1>
    <p class="lead muted">
      DIGIWIKI is a community wiki for Digimon entries, evolution lines and lore —
      built with <strong>Astro</strong>, written in plain <strong>Markdown</strong>,
      shipped with zero JavaScript overhead.
    </p>
    <div class="actions">
      <a class="btn solid" href="/hub/">Browse all entries</a>
      <a class="btn" href="/about/">✎ Contribute a page</a>
    </div>
    <div class="stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  {
    data.raid && (
      <section class="raid panel" data-raid-duration={slotSeconds}>
        <div class="raid-head">
          <div>
            <p class="eyebrow">{data.raid.eyebrow}</p>
            <h2>{data.raid.title}</h2>
          </div>
          <span class="raid-status badge accent live" data-live-label={data.raid.live} data-offline-label={data.raid.offlineLabel}>
            <span class="dot" aria-hidden="true" />
            <span class="status-text">{data.raid.live}</span>
          </span>
        </div>

        <div class="areas">
          {areasWithSlots.map((area) => (
            <div class="area">
              <div class="area-head">
                <span class="thumb">
                  {area.image ? (
                    <img src={publicPath(area.image)} alt="" loading="lazy" />
                  ) : (
                    <span aria-hidden="true">{area.emoji}</span>
                  )}
                </span>
                <div>
                  <p class="eyebrow">{area.eyebrow}</p>
                  <h3>{area.name}</h3>
                </div>
              </div>
              <div class="channels">
                {area.channels.map((ch) => (
                  <div class="channel" data-raid-offset={ch.offset}>
                    <span class="ch-label">✕ {ch.label}</span>
                    <span
                      class:list={[
                        'ch-status',
                        ch.status === 'done'
                          ? 'done'
                          : ch.status === 'now'
                            ? 'now'
                            : 'timer',
                      ]}
                    >
                      {ch.status === 'done' ? 'DONE' : ch.status === 'now' ? 'NOW' : ch.status}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    data.notice && (
      <div class="notice" role="note">
        <span class="n-icon" aria-hidden="true">⚠️</span>
        <p>{data.notice}</p>
      </div>
    )
  }

  <div class="duo">
    <section class="buffs">
      <h2>
        {data.buffs.title}
        <span class="badge mult">{data.buffs.multiplier}</span>
      </h2>
      <p class="section-lead">{data.buffs.description}</p>

      <div class="buff-panel">
        {
          data.buffs.members.map((member) => {
            // Resolve the icon: bare name → /digimon/<file>.png
            const iconPath = resolveIcon({
              collection: 'digimon',
              slug: member.slug,
              icon: member.image,
            });
            return (
              <a class="buff-row" href={`/digimon/${member.slug}/`}>
                <span class="m-box">
                  {iconPath ? (
                    <EntryIcon name={iconPath} emoji={member.emoji} />
                  ) : (
                    <span>{member.emoji}</span>
                  )}
                </span>
                <span class="m-name">{member.name}</span>
                {member.tag && <span class="badge mini-tag">{member.tag}</span>}
              </a>
            );
          })
        }
      </div>
    </section>

    <section class="patch">
      <h2>{data.patch.title}</h2>
      <p class="section-lead">{data.patch.description}</p>

      <a class="patch-cta panel" href={patchHref}>
        <span class="p-icon" aria-hidden="true">{data.patch.emoji}</span>
        <div class="patch-cta-body">
          <p class="p-top">
            <strong class="p-ver">{data.patch.version}</strong>
            <span class="badge date">{data.patch.date}</span>
          </p>
          <p class="p-summary">{data.patch.summary}</p>
          <span class="p-link">View all patch notes →</span>
        </div>
      </a>
    </section>
  </div>
  </div>
</BaseLayout>

<script>
  // ── Live raid status ──────────────────────────────────────────────
  // Recomputed every second from the visitor's clock:
  //   elapsed slot -> DONE | current slot -> NOW | future -> mm:ss countdown
  // Rotation begins at xx:00 with Forest of Beginning CH 0 and follows the
  // JSON order; each raid lasts `channelMinutes` (homepage.json).
  const slots = Array.from(
    document.querySelectorAll<HTMLElement>('[data-raid-offset]')
  );
  const duration =
    Number(
      document
        .querySelector('[data-raid-duration]')
        ?.getAttribute('data-raid-duration')
    ) || 300;

  const fmt = (totalSeconds: number): string => {
    const s = Math.max(0, Math.ceil(totalSeconds));
    const m = Math.floor(s / 60);
    const rest = s % 60;
    return `${String(m).padStart(2, '0')}:${String(rest).padStart(2, '0')}`;
  };

  function updateRaids(): void {
    let anyNow = false;
    const now = new Date();
    const intoHour =
      now.getMinutes() * 60 + now.getSeconds() + now.getMilliseconds() / 1000;

    for (const slot of slots) {
      const start = Number(slot.dataset.raidOffset ?? 0);
      const statusEl = slot.querySelector<HTMLElement>('.ch-status');
      if (!statusEl) continue;

      let cls = 'timer';
      let text = fmt(start - intoHour);
      if (intoHour >= start + duration) {
        cls = 'done';
        text = 'DONE';
      } else if (intoHour >= start) {
        cls = 'now';
        text = 'NOW';
      }

      statusEl.className = `ch-status ${cls}`;
      statusEl.textContent = text;
      if (cls === 'now') anyNow = true;
    }

    // LIVE <-> OFFLINE badge follows whether any raid is currently running
    const badge = document.querySelector<HTMLElement>('.raid-status');
    if (badge) {
      badge.classList.toggle('live', anyNow);
      badge.classList.toggle('offline', !anyNow);
      const textEl = badge.querySelector<HTMLElement>('.status-text');
      if (textEl) {
        textEl.textContent = anyNow
          ? badge.dataset.liveLabel ?? 'LIVE'
          : badge.dataset.offlineLabel ?? 'OFFLINE';
      }
    }
  }

  updateRaids();
  setInterval(updateRaids, 1000);
</script>

<style>
  /* ---- hero (matches reference) ---- */
  .hero {
    padding: 4rem 0 2.5rem;
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    margin: 0.75rem 0;
  }
  .glow {
    color: var(--accent);
    text-shadow: 0 0 24px rgba(41, 241, 156, 0.5);
  }
  .lead {
    font-size: 1.1rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.25rem;
  }
  .stats {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .stat {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1.25rem;
    display: flex;
    flex-direction: column;
    min-width: 130px;
  }
  .stat strong {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--accent-2);
  }
  .stat span {
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ---- shared bits ---- */
  .raid, .notice, .duo {
    --amber: #f5b942;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.3rem;
  }
  .raid h2,
  .buffs h2,
  .patch h2 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1.55rem;
    border: none;
    padding: 0;
    margin: 0;
    letter-spacing: 0;
  }

  /* ---- spiral raid channels ---- */
  .raid {
    margin-top: 0.5rem;
    padding: 1.5rem 1.75rem 1.9rem;
  }
  .raid-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .raid-status.offline {
    color: var(--muted);
    border-color: var(--border);
  }
  .raid-status.offline .dot {
    background: var(--muted);
    box-shadow: none;
    animation: none;
  }
  .live .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    margin-right: 0.4rem;
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% { opacity: 0.35; }
  }
  .areas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.9rem 2.75rem;
  }
  .area-head {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .thumb {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .area h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 700;
  }
  .channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }
  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.45rem 0.6rem;
    border-radius: 8px;
  }
  .ch-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ch-status {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .ch-status.done { color: var(--muted); }
  .ch-status.now {
    color: var(--accent);
    text-shadow: 0 0 10px rgba(41, 241, 156, 0.5);
  }
  .ch-status.timer { color: var(--text); }

  /* ---- warning banner ---- */
  .notice {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    margin: 1.5rem 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--amber) 35%, transparent);
    background: color-mix(in srgb, var(--amber) 8%, var(--panel));
    border-radius: var(--radius);
  }
  .notice p {
    margin: 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--amber) 75%, var(--text));
  }
  .n-icon { flex: none; }

  /* ---- buffs rotation + last patch ---- */
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.25rem;
    margin: 1.25rem 0 3.5rem;
    align-items: stretch;
  }
  @media (max-width: 1100px) {
    .duo { grid-template-columns: 1fr; }
  }
  .section-lead {
    color: var(--muted);
    margin: 0.5rem 0 1.25rem;
    font-size: 0.95rem;
  }
  .mult {
    color: var(--amber);
    border-color: color-mix(in srgb, var(--amber) 45%, transparent);
    font-weight: 700;
    margin-left: 0.45rem;
    vertical-align: middle;
  }
  .buff-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 2.25rem;
    padding: 0.35rem 1.5rem;
  }
  .buff-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px dashed var(--border);
    color: var(--text);
  }
  .buff-panel .buff-row:nth-last-child(-n+2) {
    border-bottom: none;
  }
  .m-box {
    width: 46px;
    height: 46px;
    flex: none;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.7rem;
    overflow: hidden;
  }
  .m-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .m-name {
    flex: 1;
    font-weight: 600;
  }
  .mini-tag {
    font-size: 0.62rem;
    color: var(--accent-2);
    border-color: color-mix(in srgb, var(--accent-2) 40%, transparent);
  }

  .patch-cta {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .patch-cta:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent-2) 55%, transparent);
  }
  .patch-cta-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .p-icon {
    width: 54px;
    height: 54px;
    flex: none;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    background: color-mix(in srgb, var(--accent-2) 12%, var(--panel-2));
    border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
  }
  .p-top {
    margin: 0 0 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .p-ver {
    font-family: var(--font-mono);
    color: var(--accent-2);
    font-size: 1.05rem;
  }
  .badge.date {
    color: var(--amber);
    border-color: color-mix(in srgb, var(--amber) 45%, transparent);
  }
  .p-summary {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }
  .p-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-2);
    margin-top: auto;
  }
  .patch-cta:hover .p-link {
    color: var(--accent);
  }
</style>
