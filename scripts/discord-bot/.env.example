# Discord bot token (https://discord.com/developers/applications → Bot → Token)
DISCORD_TOKEN=

# Numeric channel ID to watch (right-click channel in Discord → Copy ID)
CHANNEL_ID=

# Numeric role ID required to use the bot (right-click role → Copy ID)
ALLOWED_ROLE_ID=

# Vercel Deploy Hook URL (Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK=

# Optional override for the markdown output directory (default: src/content/patchnote)
# PATCHNOTE_DIR=src/content/patchnote
