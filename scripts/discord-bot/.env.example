# ────── Discord ──────
# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Numeric ID of the channel to watch (right-click → Copy ID in Discord)
CHANNEL_ID=

# Numeric ID of the role required to publish (right-click role → Copy ID)
ALLOWED_ROLE_ID=

# ────── GitHub (used by the bot to push the .md file) ──────
# Personal Access Token with `repo` scope:
#   https://github.com/settings/tokens → "Generate new token (classic)"
#   → check `repo` → copy the token
GITHUB_TOKEN=

# Owner/repo form, e.g. "digiedaw/62"
GITHUB_REPO=

# Commit author shown on the auto-commit
GIT_USER_NAME=DigiWiki Bot
GIT_USER_EMAIL=bot@example.local

# ────── Vercel (optional) ──────
# If set, the bot will POST to this URL after pushing to GitHub.
# If empty, Vercel's own auto-rebuild-on-push handles the deploy.
# Get one at: Vercel → Project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK=

# ────── Optional ──────
# Override the markdown output directory (default: src/content/patchnote)
# PATCHNOTE_DIR=src/content/patchnote
